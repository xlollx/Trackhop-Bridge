<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Trackhop's icon background, "the beam", copied unchanged: a near-black base crossed by a
        luminous band tilted 12 degrees whose edge passes through (72,36): a deep red glow below the
        edge, a thin violet-blue line on it, cyan above fading to white. The gradient runs along the
        perpendicular to the edge, from 0.45 H below to 0.61 H above (scripts/icon.sh, and in
        Trackhop ui/Theme.kt Brand.BeamStops).
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="61.90" android:startY="83.54"
                android:endX="85.70" android:endY="-28.44">
                <item android:offset="0.0000" android:color="#FF000000" />
                <item android:offset="0.4170" android:color="#FF400000" />
                <item android:offset="0.4321" android:color="#FF421AFF" />
                <item android:offset="0.5000" android:color="#FF59FFFF" />
                <item android:offset="1.0000" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
