<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Bridge opens Trackhop from its button: package visibility is needed (Android 11+). -->
    <queries>
        <package android:name="com.xlollx.songport" />
    </queries>

    <!-- Class names are written in full: the code's package is com.xlollx.songport.ytmbridge, the
         app's namespace com.xlollx.songport.ytmbridge.app. The sign-in screens, VerifyActivity,
         AmazonCaptureActivity and the capture FileProvider come from the :bridge library's manifest. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bridge">

        <activity
            android:name="com.xlollx.songport.ytmbridge.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Trackhop's connector-plugin discovery: the action plus the provider authority to call. -->
            <intent-filter>
                <action android:name="com.xlollx.songport.action.CONNECTOR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.xlollx.songport.connector.authority"
                android:value="com.xlollx.songport.ytmbridge.provider" />
        </activity>

        <!-- Sign-in screens: Trackhop starts them with the actions below, so here they are exported
             (inside Trackhop's own build the library keeps them private). -->
        <activity
            android:name="com.xlollx.songport.ytmbridge.LoginActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.xlollx.songport.ytmbridge.LOGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.xlollx.songport.ytmbridge.AmazonLoginActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.xlollx.songport.ytmbridge.AMAZON_LOGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Spotify and Apple Music web sessions: the user signs in on the service's own page. -->
        <activity
            android:name="com.xlollx.songport.ytmbridge.WebLoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.xlollx.songport.ytmbridge.SPOTIFY_LOGIN" />
                <action android:name="com.xlollx.songport.ytmbridge.APPLE_LOGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The interface to Trackhop. Exported, but every call checks the caller's package and signature. -->
        <provider
            android:name="com.xlollx.songport.ytmbridge.BridgeProvider"
            android:authorities="com.xlollx.songport.ytmbridge.provider"
            android:exported="true" />
    </application>
</manifest>
